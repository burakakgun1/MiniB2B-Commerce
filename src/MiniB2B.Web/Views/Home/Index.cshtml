@model MiniB2B.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container-fluid px-lg-4 mt-3">
    @if (Model.Sliders.Any())
    {
        <div id="homeCarousel" class="carousel slide shadow-sm rounded overflow-hidden mb-4" data-bs-ride="carousel">
            <div class="carousel-indicators">
                @for (int i = 0; i < Model.Sliders.Count; i++)
                {
                    <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"></button>
                }
            </div>
            <div class="carousel-inner">
                @for (int i = 0; i < Model.Sliders.Count; i++)
                {
                    var slider = Model.Sliders[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")" style="height: 360px;">
                        <img src="@slider.ImageUrl" class="d-block w-100 h-100" alt="@slider.Title" style="object-fit: cover; filter: brightness(0.7);" />
                        <div class="carousel-caption text-start d-none d-md-block p-4" style="background: rgba(15, 23, 42, 0.85); border-radius: 8px; max-width: 650px; bottom: 40px; left: 60px; z-index: 15; pointer-events: auto;">
                            <h2 class="fw-bold text-white mb-2">@slider.Title</h2>
                            @if (!string.IsNullOrEmpty(slider.Subtitle))
                            {
                                <p class="text-light mb-3">@slider.Subtitle</p>
                            }
                            @if (!string.IsNullOrEmpty(slider.TargetUrl))
                            {
                                <a href="@slider.TargetUrl" class="btn btn-primary btn-sm px-3 shadow-sm" style="position: relative; z-index: 25; pointer-events: auto;">
                                    Ürünleri İncele <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev" style="width: 50px; z-index: 5;">
                <span class="carousel-control-prev-icon" aria-label="Önceki"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next" style="width: 50px; z-index: 5;">
                <span class="carousel-control-next-icon" aria-label="Sonraki"></span>
            </button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="p-3 bg-white border rounded shadow-sm d-flex align-items-center gap-3">
                <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3">
                    <i class="bi bi-speedometer2"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Hızlı Grid Siparişi</h6>
                    <small class="text-muted">Detay sayfasına girmeden liste üzerinden doğrudan adet belirleyip sepete ekleyin.</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-white border rounded shadow-sm d-flex align-items-center gap-3">
                <div class="bg-success-subtle text-success p-3 rounded-circle fs-3">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Güvenilir Tedarik Zinciri</h6>
                    <small class="text-muted">Doğrudan ana distribütör ve fabrika güvencesiyle toptan sipariş imkanı.</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-white border rounded shadow-sm d-flex align-items-center gap-3">
                <div class="bg-info-subtle text-info p-3 rounded-circle fs-3">
                    <i class="bi bi-lock-fill"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Fiyat Snapshot Güvencesi</h6>
                    <small class="text-muted">Sipariş anındaki ürün kodları ve birim fiyatlar sipariş geçmişinizde sabit tutulur.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Öne Çıkan B2B Kategorileri</h4>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-sm">
            Tüm Kataloğu Görüntüle <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var cat in Model.Categories)
        {
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Product" asp-action="Index" asp-route-CategoryId="@cat.Id" class="text-decoration-none">
                    <div class="card h-100 text-center border-0 shadow-sm p-3 b2b-card">
                        <i class="bi bi-tags-fill text-primary mb-2 fs-2"></i>
                        <h6 class="fw-bold text-dark mb-1">@cat.Name</h6>
                        <small class="text-muted">Kategoriye Git</small>
                    </div>
                </a>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Hızlı Sipariş Ürünleri</h4>
        <a asp-controller="Product" asp-action="Index" class="text-decoration-none small fw-bold">
            Genişletilmiş Tablo Görünümü <i class="bi bi-table ms-1"></i>
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="b2b-grid-table">
            <thead>
                <tr>
                    <th style="width: 70px;" class="text-center">Görsel</th>
                    <th style="width: 140px;">Ürün Kodu</th>
                    <th>Ürün Adı</th>
                    <th style="width: 130px;">Marka</th>
                    <th style="width: 130px;" class="text-end">Birim Fiyat</th>
                    <th style="width: 170px;" class="text-center">Hızlı Sipariş</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.FeaturedProducts)
                {
                    <tr>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" class="product-thumb" style="cursor: pointer;" onclick="openProductDetail(@product.Id)" />
                            }
                            else
                            {
                                <div class="product-thumb d-flex align-items-center justify-content-center text-muted" style="cursor: pointer;" onclick="openProductDetail(@product.Id)">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <a href="javascript:void(0)" onclick="openProductDetail(@product.Id)" class="fw-bold text-decoration-none text-primary">
                                @product.ProductCode
                            </a>
                        </td>
                        <td>
                            <a href="javascript:void(0)" onclick="openProductDetail(@product.Id)" class="text-dark text-decoration-none fw-semibold">
                                @product.Name
                            </a>
                        </td>
                        <td>@product.Brand</td>
                        <td class="text-end">
                            <span class="price-tag">@product.Price.ToString("N2") ₺</span>
                        </td>
                        <td class="text-center">
                            @if (product.StockStatus == StockStatus.OutOfStock)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>
                                    Tükendi
                                </button>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center gap-1">
                                    <input type="number" id="home-qty-@product.Id" class="form-control form-control-sm text-center" value="1" min="1" style="width: 58px;" />
                                    <button type="button" class="btn btn-sm btn-b2b-cart" onclick="quickAddToCart(@product.Id, 'home-qty-@product.Id')">
                                        <i class="bi bi-cart-plus"></i> Ekle
                                    </button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
