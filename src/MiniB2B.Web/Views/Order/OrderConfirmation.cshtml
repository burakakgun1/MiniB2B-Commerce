@{
    ViewData["Title"] = "Sipariş Alındı";
    var orderNumber = ViewBag.OrderNumber as string;
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm p-5 rounded-4">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4.5rem;"></i>
                </div>
                <h3 class="fw-bold mb-2">Siparişiniz Başarıyla Alındı!</h3>
                <p class="text-muted">Siparişiniz sisteme kaydedildi ve depo kontrolü için yönetici onayına sunuldu.</p>

                <div class="alert alert-light border py-3 my-3">
                    <div class="small text-muted mb-1">Sipariş Takip Numarası:</div>
                    <div class="fs-4 fw-bold text-primary">@orderNumber</div>
                </div>

                <p class="small text-muted mb-4">
                    Sipariş durumunu ve onay aşamalarını dilediğiniz an <strong>"Siparişlerim"</strong> sayfasından anlık olarak takip edebilirsiniz.
                </p>

                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="MyOrders" class="btn btn-primary px-4">
                        <i class="bi bi-receipt me-1"></i>Siparişlerime Git
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-grid-3x3-gap me-1"></i>Kataloğa Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
