@model MiniB2B.Core.Models.PagedResult<MiniB2B.Core.Models.OrderListDto>
@{
    ViewData["Title"] = "Siparişlerim";
}

<div class="container-fluid px-lg-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-receipt text-primary me-2"></i>Sipariş Geçmişim
            </h3>
            <small class="text-muted">Daha önce oluşturduğunuz siparişler ve güncel onay durumları</small>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Sipariş Ver
        </a>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <i class="bi bi-journal-x text-muted" style="font-size: 3.5rem;"></i>
            <h5 class="mt-3">Henüz verilmiş bir siparişiniz bulunmuyor.</h5>
            <p class="text-muted">B2B ürün kataloğumuz üzerinden hızlı sipariş oluşturabilirsiniz.</p>
            <div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-grid-3x3-gap me-1"></i>Kataloğa Git
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sipariş Numarası</th>
                            <th>Sipariş Tarihi</th>
                            <th class="text-center">Kalem Sayısı</th>
                            <th class="text-end">Toplam Tutar</th>
                            <th class="text-center">Sipariş Durumu</th>
                            <th class="text-center" style="width: 120px;">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Items)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <span class="text-primary">@order.OrderNumber</span>
                                </td>
                                <td>@order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-center">@order.ItemCount Kalem</td>
                                <td class="text-end fw-bold text-dark">@order.TotalAmount.ToString("N2") ₺</td>
                                <td class="text-center">
                                    @switch (order.OrderStatus)
                                    {
                                        case OrderStatus.Pending:
                                            <span class="badge badge-status-pending border px-3 py-1">
                                                <i class="bi bi-clock-history me-1"></i>Onay Bekliyor
                                            </span>
                                            break;
                                        case OrderStatus.Approved:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                                <i class="bi bi-check-circle me-1"></i>Onaylandı
                                            </span>
                                            break;
                                        case OrderStatus.Rejected:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                                                <i class="bi bi-x-circle me-1"></i>Reddedildi
                                            </span>
                                            break;
                                        case OrderStatus.Shipped:
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-1">
                                                <i class="bi bi-truck me-1"></i>Kargoya Verildi
                                            </span>
                                            break;
                                        case OrderStatus.Completed:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1">
                                                <i class="bi bi-check-all me-1"></i>Tamamlandı
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Detail" asp-route-id="@order.Id" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-eye me-1"></i>Detay
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
