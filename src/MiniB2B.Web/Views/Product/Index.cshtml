@model MiniB2B.Web.Models.ProductPageViewModel
@{
    ViewData["Title"] = "Ürün Kataloğu";
}

<div class="container-fluid px-lg-4 mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>B2B Ürün Kataloğu
            </h3>
            <small class="text-muted">Toplu ürün listesi ve hızlı sipariş tablosu</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
                Toplam <strong>@Model.Products.TotalCount</strong> Ürün
            </span>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Arama</label>
                        <div class="input-group input-group-sm">
                            <input type="text" name="SearchText" value="@Model.Filter.SearchText" class="form-control" placeholder="Ad, kod, marka, üretici veya özel kod..." />
                            @if (!string.IsNullOrEmpty(Model.Filter.SearchText))
                            {
                                <a asp-action="Index" class="btn btn-outline-secondary" title="Aramayı Temizle">
                                    <i class="bi bi-x"></i>
                                </a>
                            }
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Kategori</label>
                        <select name="CategoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Tüm Kategoriler</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.Filter.CategoryId == cat.Id)">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Marka</label>
                        <select name="Brand" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Tüm Markalar</option>
                            @foreach (var brand in Model.Brands)
                            {
                                <option value="@brand" selected="@(Model.Filter.Brand == brand)">@brand</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Durum</label>
                        <select name="StockStatus" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Tüm Ürünler</option>
                            <option value="InStock" selected="@(Model.Filter.StockStatus == StockStatus.InStock)">Sadece Stoktakiler</option>
                            <option value="OutOfStock" selected="@(Model.Filter.StockStatus == StockStatus.OutOfStock)">Tükenenler</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Sıralama</label>
                        <select name="SortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="Name" selected="@(Model.Filter.SortBy == "Name")">Ürün Adı</option>
                            <option value="Price" selected="@(Model.Filter.SortBy == "Price")">Birim Fiyat</option>
                            <option value="Code" selected="@(Model.Filter.SortBy == "Code")">Ürün Kodu</option>
                            <option value="Brand" selected="@(Model.Filter.SortBy == "Brand")">Marka</option>
                        </select>
                    </div>

                    <div class="col-md-1 d-flex gap-1">
                        <button type="submit" class="btn btn-sm btn-primary w-100" title="Filtrele">
                            <i class="bi bi-funnel-fill"></i>
                        </button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Sıfırla">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @await Html.PartialAsync("_DynamicProductGrid", Model)
</div>
