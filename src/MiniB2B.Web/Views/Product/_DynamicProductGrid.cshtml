@model MiniB2B.Web.Models.ProductPageViewModel

@if (!Model.Products.Items.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center">
        <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3">Arama kriterlerinize uygun ürün bulunamadı.</h5>
        <p class="text-muted">Lütfen filtreleri sıfırlayarak veya farklı anahtar kelimelerle tekrar deneyiniz.</p>
        <div>
            <a asp-action="Index" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Filtreleri Temizle
            </a>
        </div>
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="b2b-grid-table">
            <thead>
                <tr>
                    @foreach (var col in Model.Columns)
                    {
                        var alignClass = col.Alignment switch
                        {
                            "right" => "text-end",
                            "center" => "text-center",
                            _ => "text-start"
                        };

                        var responsiveClass = "";
                        if (!col.VisibleOnMobile && !col.VisibleOnTablet) responsiveClass = "d-none d-lg-table-cell";
                        else if (!col.VisibleOnMobile) responsiveClass = "d-none d-md-table-cell";

                        <th class="@alignClass @responsiveClass" style="@(!string.IsNullOrEmpty(col.Width) ? $"width: {col.Width};" : "")">
                            @col.HeaderTitle
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products.Items)
                {
                    <tr>
                        @foreach (var col in Model.Columns)
                        {
                            var alignClass = col.Alignment switch
                            {
                                "right" => "text-end",
                                "center" => "text-center",
                                _ => "text-start"
                            };

                            var responsiveClass = "";
                            if (!col.VisibleOnMobile && !col.VisibleOnTablet) responsiveClass = "d-none d-lg-table-cell";
                            else if (!col.VisibleOnMobile) responsiveClass = "d-none d-md-table-cell";

                            <td class="@alignClass @responsiveClass">
                                @switch (col.RenderType)
                                {
                                    case GridRenderType.Image:
                                        if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl" alt="@product.Name" class="product-thumb" style="cursor: pointer;" onclick="openProductDetail(@product.Id)" />
                                        }
                                        else
                                        {
                                            <div class="product-thumb d-flex align-items-center justify-content-center text-muted" style="cursor: pointer;" onclick="openProductDetail(@product.Id)">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                        break;

                                    case GridRenderType.DetailLink:
                                        if (col.PropertyName == "ProductCode")
                                        {
                                            <a href="javascript:void(0)" onclick="openProductDetail(@product.Id)" class="fw-bold text-decoration-none text-primary">
                                                @product.ProductCode
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="javascript:void(0)" onclick="openProductDetail(@product.Id)" class="text-dark text-decoration-none fw-semibold">
                                                @product.Name
                                            </a>
                                        }
                                        break;

                                    case GridRenderType.Text:
                                        var textVal = col.PropertyName switch
                                        {
                                            "Brand" => product.Brand,
                                            "ManufacturerCode" => product.ManufacturerCode ?? "-",
                                            "SpecialCode1" => product.SpecialCode1 ?? "-",
                                            "SpecialCode2" => product.SpecialCode2 ?? "-",
                                            "CategoryName" => product.CategoryName,
                                            _ => "-"
                                        };
                                        <span>@textVal</span>
                                        break;

                                    case GridRenderType.StockBadge:
                                        if (product.StockStatus == StockStatus.OutOfStock)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Tükendi</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                        break;

                                    case GridRenderType.Currency:
                                        <span class="price-tag">@product.Price.ToString("N2") ₺</span>
                                        break;

                                    case GridRenderType.AddToCartAction:
                                        if (product.StockStatus == StockStatus.OutOfStock)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>
                                                Tükendi
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center gap-1">
                                                <input type="number" id="grid-qty-@product.Id" class="form-control form-control-sm text-center" value="1" min="1" style="width: 58px;" />
                                                <button type="button" class="btn btn-sm btn-b2b-cart" onclick="quickAddToCart(@product.Id, 'grid-qty-@product.Id')" title="Hızlı Sepete Ekle">
                                                    <i class="bi bi-cart-plus"></i> Ekle
                                                </button>
                                            </div>
                                        }
                                        break;

                                    default:
                                        <span>-</span>
                                        break;
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Products.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Sayfalama">
            <ul class="pagination justify-content-center">
                <li class="page-item @(!Model.Products.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@(Model.Products.PageNumber - 1)"
                       asp-route-SearchText="@Model.Filter.SearchText"
                       asp-route-CategoryId="@Model.Filter.CategoryId"
                       asp-route-Brand="@Model.Filter.Brand"
                       asp-route-StockStatus="@Model.Filter.StockStatus"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-SortDescending="@Model.Filter.SortDescending">
                        <i class="bi bi-chevron-left"></i> Önceki
                    </a>
                </li>

                @for (int i = 1; i <= Model.Products.TotalPages; i++)
                {
                    <li class="page-item @(Model.Products.PageNumber == i ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pageNumber="@i"
                           asp-route-SearchText="@Model.Filter.SearchText"
                           asp-route-CategoryId="@Model.Filter.CategoryId"
                           asp-route-Brand="@Model.Filter.Brand"
                           asp-route-StockStatus="@Model.Filter.StockStatus"
                           asp-route-SortBy="@Model.Filter.SortBy"
                           asp-route-SortDescending="@Model.Filter.SortDescending">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(!Model.Products.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@(Model.Products.PageNumber + 1)"
                       asp-route-SearchText="@Model.Filter.SearchText"
                       asp-route-CategoryId="@Model.Filter.CategoryId"
                       asp-route-Brand="@Model.Filter.Brand"
                       asp-route-StockStatus="@Model.Filter.StockStatus"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-SortDescending="@Model.Filter.SortDescending">
                        Sonraki <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
