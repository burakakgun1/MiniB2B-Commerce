<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini B2B E-Ticaret Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-b2b">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-seam-fill text-primary-light fs-4"></i>
                    <span>Mini B2B</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Ana Sayfa
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap me-1"></i>Ürün Kataloğu
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Order" asp-action="MyOrders">
                                    <i class="bi bi-receipt me-1"></i>Siparişlerim
                                </a>
                            </li>
                        }
                    </ul>

                    <form class="d-flex me-lg-3 my-2 my-lg-0" asp-controller="Product" asp-action="Index" method="get">
                        <div class="input-group input-group-sm" style="min-width: 260px;">
                            <input class="form-control" type="search" name="SearchText" placeholder="Ürün adı, kod veya marka ara..." aria-label="Ara">
                            <button class="btn btn-outline-light" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-light position-relative btn-sm" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3 me-1"></i>Sepetim
                                <span id="cart-badge-count" class="badge bg-danger badge-cart-count" style="display: none;">0</span>
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-warning btn-sm text-dark fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-shield-lock-fill me-1"></i>Yönetim Paneli
                                    </a>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="userMenu" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">
                                            <i class="bi bi-box2 me-2"></i>Siparişlerim
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Giriş Yap
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i>Kayıt Ol
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container-fluid px-lg-4 mt-3">
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container-fluid px-lg-4 mt-3">
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="border-top py-3 bg-white mt-auto text-muted">
        <div class="container-fluid px-lg-4 text-center text-md-start">
            <span class="small">&copy; @DateTime.UtcNow.Year Mini B2B E-Ticaret Portalı. Tüm hakları saklıdır.</span>
        </div>
    </footer>

    <div id="productDetailModalContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            fetch('/Cart/GetCartCount')
                .then(r => r.json())
                .then(d => { if (d && d.count > 0) updateCartBadge(d.count); })
                .catch(() => {});
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
