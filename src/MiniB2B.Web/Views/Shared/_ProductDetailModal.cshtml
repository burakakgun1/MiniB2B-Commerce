@model MiniB2B.Core.Models.ProductDetailDto

<div class="modal fade" id="productDetailModal" tabindex="-1" aria-labelledby="productDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title d-flex align-items-center gap-2" id="productDetailModalLabel">
                    <i class="bi bi-info-circle-fill text-primary"></i>
                    <span>@Model.ProductCode - @Model.Name</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <div class="col-md-5 text-center">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded border shadow-sm" style="max-height: 280px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center rounded border" style="height: 240px;">
                                <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
                            </div>
                        }

                        @if (Model.StockStatus == StockStatus.OutOfStock)
                        {
                            <div class="mt-3">
                                <span class="badge bg-danger py-2 px-3 fs-6">
                                    <i class="bi bi-x-circle me-1"></i>Tükendi
                                </span>
                            </div>
                        }
                    </div>

                    <div class="col-md-7">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-secondary">@Model.CategoryName</span>
                            <span class="fs-4 fw-bold text-primary">@Model.Price.ToString("N2") ₺</span>
                        </div>

                        <h4 class="fw-bold mb-3">@Model.Name</h4>

                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <tbody>
                                    <tr>
                                        <th class="bg-light w-40">Ürün Kodu</th>
                                        <td class="fw-bold text-dark">@Model.ProductCode</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Marka</th>
                                        <td>@Model.Brand</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Üretici Kodu</th>
                                        <td>@(Model.ManufacturerCode ?? "-")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Özel Kod 1</th>
                                        <td>@(Model.SpecialCode1 ?? "-")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Özel Kod 2</th>
                                        <td>@(Model.SpecialCode2 ?? "-")</td>
                                    </tr>
                                    @if (Model.StockStatus == StockStatus.OutOfStock)
                                    {
                                        <tr>
                                            <th class="bg-light">Durum</th>
                                            <td><span class="text-danger fw-bold">Tükendi</span></td>
                                        </tr>
                                    }
                                    <tr>
                                        <th class="bg-light">Birim Fiyat</th>
                                        <td class="fw-bold text-primary">@Model.Price.ToString("N2") ₺</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <h6 class="fw-bold text-muted">Açıklama</h6>
                            <p class="small text-secondary mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "Ürün açıklaması bulunmuyor." : Model.Description)</p>
                        </div>

                        <hr class="my-4" />

                        @if (Model.StockStatus != StockStatus.OutOfStock)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <div class="input-group" style="max-width: 140px;">
                                    <span class="input-group-text">Adet</span>
                                    <input type="number" id="modal-qty-@Model.Id" class="form-control text-center" value="1" min="1">
                                </div>
                                <button type="button" class="btn btn-primary flex-grow-1" onclick="quickAddToCart(@Model.Id, 'modal-qty-@Model.Id')">
                                    <i class="bi bi-cart-plus me-1"></i> Sepete Ekle
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger mb-0 py-2">
                                <i class="bi bi-x-circle me-1"></i> Bu ürün tükendiğinden sipariş verilemez.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
