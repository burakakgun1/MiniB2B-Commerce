@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-5 rounded-4">
                <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
                <h3 class="fw-bold mt-3">Yetkisiz Erişim</h3>
