                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                        <i class="bi bi-house-door me-1"></i>Ana Sayfaya Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
