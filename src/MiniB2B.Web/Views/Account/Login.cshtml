@model MiniB2B.Core.Models.LoginViewModel
@{
    ViewData["Title"] = "Müşteri Girişi";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex p-3 rounded-circle bg-primary-subtle text-primary mb-3">
                            <i class="bi bi-person-fill fs-2"></i>
                        </div>
                        <h4 class="fw-bold">Müşteri Girişi</h4>
                        <p class="text-muted small">Lütfen sipariş vermek ve kataloğu incelemek için giriş yapınız.</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="UsernameOrEmail" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="UsernameOrEmail" class="form-control" placeholder="ornekkullanici@b2b.com" />
                            </div>
                            <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" asp-for="RememberMe">
                            <label class="form-check-label small" asp-for="RememberMe">
                                Oturumumu açık tut
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Giriş Yap
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <span class="small text-muted">Henüz hesabınız yok mu?</span>
                        <a asp-action="Register" class="small fw-bold text-decoration-none ms-1">Hemen Kayıt Ol</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
