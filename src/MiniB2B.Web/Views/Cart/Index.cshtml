@model MiniB2B.Core.Models.CartDto
@{
    ViewData["Title"] = "Sepetim";
}

<div class="container-fluid px-lg-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-cart3 text-primary me-2"></i>Alışveriş Sepeti
            </h3>
            <small class="text-muted">Sipariş öncesi sepet içeriğinizi kontrol ediniz.</small>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Kataloğa Geri Dön
        </a>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <i class="bi bi-cart-x text-muted" style="font-size: 3.5rem;"></i>
            <h4 class="fw-bold mt-3">Sepetinizde ürün bulunmamaktadır</h4>
            <p class="text-muted">B2B kataloğumuzdaki binlerce endüstriyel üründen sepetinize hemen ekleyebilirsiniz.</p>
            <div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-grid-3x3-gap me-1"></i>Ürün Kataloğuna Git
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 70px;" class="text-center">Görsel</th>
                                    <th>Ürün Bilgisi</th>
                                    <th class="text-end" style="width: 140px;">Birim Fiyat</th>
                                    <th class="text-center" style="width: 140px;">Adet</th>
                                    <th class="text-end" style="width: 140px;">Tutar</th>
                                    <th class="text-center" style="width: 60px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.ProductName" class="product-thumb" />
                                            }
                                            else
                                            {
                                                <div class="product-thumb d-flex align-items-center justify-content-center text-muted">
                                                    <i class="bi bi-image"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@item.ProductName</div>
                                            <div class="small text-muted">
                                                <span class="badge bg-light text-dark border">@item.ProductCode</span>
                                                <span class="ms-1">@item.Brand</span>
                                            </div>
                                            @if (item.StockStatus == StockStatus.OutOfStock)
                                            {
                                                <small class="text-danger fw-semibold d-block mt-1">
                                                    <i class="bi bi-x-circle"></i> Tükendi / Stok Yetersiz
                                                </small>
                                            }
                                        </td>
                                        <td class="text-end fw-semibold">
                                            @item.UnitPrice.ToString("N2") ₺
                                        </td>
                                        <td class="text-center">
                                            <div class="input-group input-group-sm mx-auto" style="width: 100px;">
                                                <input type="number" class="form-control text-center" value="@item.Quantity" min="1" onchange="updateCartItemQuantity(@item.Id, this.value)">
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold text-primary">
                                            @item.TotalPrice.ToString("N2") ₺
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-link text-danger p-0" onclick="removeCartItem(@item.Id)" title="Sepetten Çıkar">
                                                <i class="bi bi-trash3 fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Sipariş Özeti</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Toplam Kalem:</span>
                        <span class="fw-semibold">@Model.Items.Count</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Toplam Ürün Adedi:</span>
                        <span class="fw-semibold">@Model.TotalQuantity</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold">Genel Toplam:</span>
                        <span class="fs-4 fw-bold text-primary">@Model.TotalAmount.ToString("N2") ₺</span>
                    </div>

                    <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary w-100 py-3 fw-bold fs-6">
                        <i class="bi bi-check2-circle me-1"></i> Siparişi Onayla ve Tamamla
                    </a>

                    <div class="mt-3 text-center">
                        <small class="text-muted">
                            <i class="bi bi-shield-check me-1"></i>Güvenli B2B sipariş sistemi
                        </small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
