@model List<MiniB2B.Core.Models.GridColumnDto>
@{
    ViewData["Title"] = "Grid Kolon Yapılandırması";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-4 border-bottom">
    <div>
        <h2 class="h3 fw-bold mb-0">Dinamik Grid Kolon Yapılandırması</h2>
        <small class="text-muted">Ürün listeleme tablosundaki kolonları, başlıkları, sıraları ve görünürlükleri kod değiştirmeden veritabanından yönetin</small>
    </div>
</div>

<div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-3 mb-4">
    <i class="bi bi-gear-wide-connected fs-3"></i>
    <div>
        <strong>Dinamik Kolon Mimarisi:</strong>
        Ürün tablosu veritabanındaki bu konfigürasyon tablosundan beslenir. Burada yapacağınız kolon başlığı, görüntüleme sırası veya görünürlük değişiklikleri kod derlemesi gerekmeden kullanıcı arayüzündeki B2B grid'ine anında yansır.
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width: 70px;">Sıra</th>
                    <th>Özellik (Property)</th>
                    <th>Görünen Başlık</th>
                    <th>Render Tipi</th>
                    <th>Genişlik</th>
                    <th>Hizalama</th>
                    <th class="text-center">Görünür</th>
                    <th class="text-center">Mobil</th>
                    <th class="text-center">Tablet</th>
                    <th class="text-center">Masaüstü</th>
                    <th class="text-center" style="width: 100px;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var col in Model)
                {
                    <tr>
                        <td class="text-center fw-bold">@col.DisplayOrder</td>
                        <td><code>@col.PropertyName</code></td>
                        <td class="fw-semibold">@col.HeaderTitle</td>
                        <td><span class="badge bg-secondary">@col.RenderType</span></td>
                        <td>@(col.Width ?? "auto")</td>
                        <td>@col.Alignment</td>
                        <td class="text-center">
                            @if (col.IsVisible)
                            {
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                            }
                        </td>
                        <td class="text-center">
                            @(col.VisibleOnMobile ? "Evet" : "Hayır")
                        </td>
                        <td class="text-center">
                            @(col.VisibleOnTablet ? "Evet" : "Hayır")
                        </td>
                        <td class="text-center">
                            @(col.VisibleOnDesktop ? "Evet" : "Hayır")
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@col.Id" class="btn btn-sm btn-outline-primary" title="Düzenle">
                                <i class="bi bi-pencil me-1"></i>Düzenle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
