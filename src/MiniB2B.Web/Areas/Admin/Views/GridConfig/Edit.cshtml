@model MiniB2B.Core.Models.UpdateGridColumnDto
@{
    ViewData["Title"] = "Kolon Düzenle - " + Model.HeaderTitle;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-4 border-bottom">
    <div>
        <h2 class="h3 fw-bold mb-0">Grid Kolonunu Düzenle</h2>
        <small class="text-muted"><code>@Model.HeaderTitle</code> kolonunun render ve görünürlük ayarları</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Kolon Listesine Dön
    </a>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="HeaderTitle" class="form-label fw-semibold small"></label>
                    <input asp-for="HeaderTitle" class="form-control" />
                    <span asp-validation-for="HeaderTitle" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold small"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="1" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Width" class="form-label fw-semibold small"></label>
                        <input asp-for="Width" class="form-control" placeholder="Örn: 120px veya auto" />
                        <span asp-validation-for="Width" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Alignment" class="form-label fw-semibold small"></label>
                        <select asp-for="Alignment" class="form-select">
                            <option value="left">Sola (Left)</option>
                            <option value="center">Ortala (Center)</option>
                            <option value="right">Sağa (Right)</option>
                        </select>
                        <span asp-validation-for="Alignment" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <h6 class="fw-bold mb-3">Görünürlük Kuralları</h6>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" asp-for="IsVisible">
                    <label class="form-check-label fw-semibold" asp-for="IsVisible">
                        Kolon Genel Olarak Görünür
                    </label>
                </div>

                <div class="row g-2 mb-4 ms-2">
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="VisibleOnMobile">
                            <label class="form-check-label small" asp-for="VisibleOnMobile">
                                Mobilde Göster
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="VisibleOnTablet">
                            <label class="form-check-label small" asp-for="VisibleOnTablet">
                                Tablette Göster
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="VisibleOnDesktop">
                            <label class="form-check-label small" asp-for="VisibleOnDesktop">
                                Masaüstünde Göster
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Ayarları Kaydet
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
