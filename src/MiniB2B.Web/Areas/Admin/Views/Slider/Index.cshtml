@model List<MiniB2B.Core.Entities.SliderItem>
@{
    ViewData["Title"] = "Slider & Banner Yönetimi";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-4 border-bottom">
    <div>
        <h2 class="h3 fw-bold mb-0">Slider & Banner Yönetimi</h2>
        <small class="text-muted">Kullanıcı arayüzü ana sayfasında gösterilen kampanya, duyuru ve reklam slider'larını yönetin</small>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Yeni Slider Ekle
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width: 70px;">Sıra</th>
                    <th style="width: 130px;">Önizleme</th>
                    <th>Başlık & Alt Başlık</th>
                    <th>Hedef URL</th>
                    <th class="text-center" style="width: 100px;">Durum</th>
                    <th class="text-center" style="width: 130px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Kayıtlı slider bulunamadı.</td>
                    </tr>
                }
                @foreach (var s in Model)
                {
                    <tr class="@(!s.IsActive ? "table-light text-muted opacity-75" : "")">
                        <td class="text-center fw-bold">@s.DisplayOrder</td>
                        <td>
                            <img src="@s.ImageUrl" alt="@s.Title" class="rounded border shadow-sm" style="width: 110px; height: 55px; object-fit: cover; background: #f8fafc;" />
                        </td>
                        <td>
                            <div class="fw-bold">@s.Title</div>
                            <small class="text-muted">@s.Subtitle</small>
                        </td>
                        <td><code>@(string.IsNullOrWhiteSpace(s.TargetUrl) ? "-" : s.TargetUrl)</code></td>
                        <td class="text-center">
                            @if (s.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Pasif</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline-primary" title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (s.IsActive)
                                {
                                    <form asp-action="ToggleStatus" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Bu sliderı pasife almak istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary" title="Pasife Al">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="ToggleStatus" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Bu sliderı aktife almak istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-success" title="Aktife Al">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Bu slider öğesini tamamen silmek istediğinize emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
