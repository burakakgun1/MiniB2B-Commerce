@model MiniB2B.Core.Models.SliderCreateEditDto
@{
    ViewData["Title"] = "Slider Düzenle";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-4 border-bottom">
    <div>
        <h2 class="h3 fw-bold mb-0">Slider / Banner Düzenle</h2>
        <small class="text-muted"><code>@Model.Title</code> slider içeriğini güncelleyin</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Slider Listesine Dön
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Subtitle" class="form-label fw-semibold small"></label>
                    <input asp-for="Subtitle" class="form-control" />
                    <span asp-validation-for="Subtitle" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ImageUrl" class="form-label fw-semibold small"></label>
                        <input asp-for="ImageUrl" class="form-control" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mt-2">
                                <img src="@Model.ImageUrl" alt="Mevcut Görsel" class="rounded border" style="max-height: 80px; max-width: 100%; object-fit: cover;" />
                                <small class="text-muted d-block mt-1">Mevcut görsel</small>
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Yeni Görsel Yükle</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        @Html.ValidationMessage("imageFile", new { @class = "text-danger small d-block mt-1" })
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="TargetUrl" class="form-label fw-semibold small"></label>
                        <input asp-for="TargetUrl" class="form-control" />
                        <span asp-validation-for="TargetUrl" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold small"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="1" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive">
                    <label class="form-check-label fw-semibold" asp-for="IsActive">
                        Slider Yayında (Aktif)
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Güncelle
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
