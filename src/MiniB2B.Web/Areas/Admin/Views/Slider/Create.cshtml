@model MiniB2B.Core.Models.SliderCreateEditDto
@{
    ViewData["Title"] = "Yeni Slider Ekle";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-4 border-bottom">
    <div>
        <h2 class="h3 fw-bold mb-0">Yeni Slider / Banner Ekle</h2>
        <small class="text-muted">Ana sayfada dönecek yeni bir kampanya görseli, öne çıkan ürün veya duyuru ekleyin</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Slider Listesine Dön
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small"></label>
                    <input asp-for="Title" class="form-control" placeholder="Örn: Otomasyon Ürünlerinde %20 İndirim" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Subtitle" class="form-label fw-semibold small"></label>
                    <input asp-for="Subtitle" class="form-control" placeholder="Örn: Siemens ve Schneider şalt malzemelerinde toptan fırsatlar..." />
                    <span asp-validation-for="Subtitle" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ImageUrl" class="form-label fw-semibold small"></label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://... veya boş bırakıp dosya yükleyin" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Görsel Dosyası Yükle</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        @Html.ValidationMessage("imageFile", new { @class = "text-danger small d-block mt-1" })
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="TargetUrl" class="form-label fw-semibold small"></label>
                        <input asp-for="TargetUrl" class="form-control" placeholder="/Product?brand=Siemens" />
                        <span asp-validation-for="TargetUrl" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold small"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="1" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive">
                    <label class="form-check-label fw-semibold" asp-for="IsActive">
                        Slider Yayında (Aktif)
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Kaydet
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
