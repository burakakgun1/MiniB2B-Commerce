@model MiniB2B.Core.Models.PagedResult<MiniB2B.Core.Models.ProductListItemDto>
@{
    ViewData["Title"] = "Ürün Yönetimi";
    var categories = ViewBag.Categories as List<MiniB2B.Core.Entities.Category> ?? new();
    var brands = ViewBag.Brands as List<string> ?? new();
    var filter = ViewBag.Filter as MiniB2B.Core.Models.ProductFilterDto ?? new();
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-4 border-bottom">
    <div>
        <h2 class="h3 fw-bold mb-0">Ürün Yönetimi</h2>
        <small class="text-muted">Katalogdaki tüm ürünleri listeleyin, düzenleyin ve yeni ürün ekleyin</small>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Yeni Ürün Ekle
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Arama</label>
                    <input type="text" name="SearchText" value="@filter.SearchText" class="form-control form-control-sm" placeholder="Ad, kod, marka, üretici veya özel kod..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Kategori</label>
                    <select name="CategoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Tüm Kategoriler</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(filter.CategoryId == cat.Id)">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">Marka</label>
                    <select name="Brand" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Tüm Markalar</option>
                        @foreach (var b in brands)
                        {
                            <option value="@b" selected="@(filter.Brand == b)">@b</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">Durum</label>
                    <select name="IsActive" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Tümü</option>
                        <option value="true" selected="@(filter.IsActive == true)">Aktifler</option>
                        <option value="false" selected="@(filter.IsActive == false)">Pasifler</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="bi bi-funnel-fill me-1"></i>Filtrele
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Sıfırla">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;" class="text-center">Görsel</th>
                    <th style="width: 130px;">Ürün Kodu</th>
                    <th>Ürün Bilgisi</th>
                    <th>Kategori</th>
                    <th>Marka</th>
                    <th class="text-center" style="width: 90px;">Stok</th>
                    <th class="text-center" style="width: 80px;">Kritik</th>
                    <th class="text-end" style="width: 110px;">Fiyat</th>
                    <th class="text-center" style="width: 80px;">Durum</th>
                    <th class="text-center" style="width: 100px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">Kayıtlı ürün bulunamadı.</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr class="@(!item.IsActive ? "table-light text-muted opacity-75" : "")">
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" class="product-thumb rounded border" style="width: 38px; height: 38px; object-fit: contain; background: #fff;" />
                            }
                            else
                            {
                                <div class="product-thumb d-flex align-items-center justify-content-center text-muted rounded border bg-light" style="width: 38px; height: 38px;">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                        </td>
                        <td class="fw-bold font-monospace">@item.ProductCode</td>
                        <td>
                            <div class="fw-semibold">@item.Name</div>
                            <div class="small text-muted d-flex flex-wrap gap-2 mt-1">
                                @if (!string.IsNullOrEmpty(item.ManufacturerCode))
                                {
                                    <span><i class="bi bi-upc me-1"></i>Üretici: @item.ManufacturerCode</span>
                                }
                                @if (!string.IsNullOrEmpty(item.SpecialCode1))
                                {
                                    <span><i class="bi bi-tag me-1"></i>Özel 1: @item.SpecialCode1</span>
                                }
                                @if (!string.IsNullOrEmpty(item.SpecialCode2))
                                {
                                    <span><i class="bi bi-tag-fill me-1"></i>Özel 2: @item.SpecialCode2</span>
                                }
                            </div>
                        </td>
                        <td>@item.CategoryName</td>
                        <td>@item.Brand</td>
                        <td class="text-center">
                            @if (item.StockQuantity <= 0)
                            {
                                <span class="badge bg-danger">0</span>
                            }
                            else if (item.StockQuantity <= item.CriticalStockLevel)
                            {
                                <span class="badge bg-warning text-dark">@item.StockQuantity</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@item.StockQuantity</span>
                            }
                        </td>
                        <td class="text-center text-muted small">@item.CriticalStockLevel</td>
                        <td class="text-end fw-bold">@item.Price.ToString("N2") ₺</td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Pasif</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (item.IsActive)
                                {
                                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu ürünü pasife almak istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary" title="Pasife Al">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu ürünü tekrar aktife almak istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-success" title="Aktife Al">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1 || Model.TotalCount > 0)
    {
        <div class="card-footer bg-white py-3 border-top d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div class="text-muted small">
                Toplam <strong>@Model.TotalCount</strong> ürün | Sayfa <strong>@Model.PageNumber</strong> / <strong>@Math.Max(1, Model.TotalPages)</strong>
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Ürün Sayfalama">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-PageNumber="@(Model.PageNumber - 1)"
                               asp-route-SearchText="@filter.SearchText"
                               asp-route-CategoryId="@filter.CategoryId"
                               asp-route-Brand="@filter.Brand"
                               asp-route-IsActive="@filter.IsActive">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-PageNumber="@p"
                                   asp-route-SearchText="@filter.SearchText"
                                   asp-route-CategoryId="@filter.CategoryId"
                                   asp-route-Brand="@filter.Brand"
                                   asp-route-IsActive="@filter.IsActive">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-PageNumber="@(Model.PageNumber + 1)"
                               asp-route-SearchText="@filter.SearchText"
                               asp-route-CategoryId="@filter.CategoryId"
                               asp-route-Brand="@filter.Brand"
                               asp-route-IsActive="@filter.IsActive">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>
