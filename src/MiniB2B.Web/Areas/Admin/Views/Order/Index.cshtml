@model MiniB2B.Core.Models.PagedResult<MiniB2B.Core.Models.OrderListDto>
@{
    ViewData["Title"] = "Sipariş Yönetimi";
    var currentStatus = ViewBag.CurrentStatus as OrderStatus?;
    var searchText = ViewBag.SearchText as string ?? string.Empty;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-4 border-bottom">
    <div>
        <h2 class="h3 fw-bold mb-0">Sipariş Yönetimi</h2>
        <small class="text-muted">Müşteriler tarafından verilen tüm siparişleri ve onay durumlarını yönetin</small>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="mb-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted mb-1">Sipariş & Müşteri Arama</label>
                    <input type="text" name="search" value="@searchText" class="form-control form-control-sm" placeholder="Sipariş numarası (ORD-...), müşteri adı, kullanıcı adı veya e-posta..." />
                    @if (currentStatus.HasValue)
                    {
                        <input type="hidden" name="status" value="@currentStatus.Value" />
                    }
                </div>
                <div class="col-md-3 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Ara
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Sıfırla">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>
        </form>

        <div class="d-flex flex-wrap gap-2 border-top pt-3">
            <a asp-action="Index" asp-route-search="@searchText" class="btn btn-sm @(!currentStatus.HasValue ? "btn-dark" : "btn-outline-secondary")">
                Tüm Siparişler
            </a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Pending" asp-route-search="@searchText" class="btn btn-sm @(currentStatus == OrderStatus.Pending ? "btn-warning" : "btn-outline-warning text-dark")">
                <i class="bi bi-clock me-1"></i>Onay Bekleyenler
            </a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Approved" asp-route-search="@searchText" class="btn btn-sm @(currentStatus == OrderStatus.Approved ? "btn-success" : "btn-outline-success")">
                <i class="bi bi-check-circle me-1"></i>Onaylananlar
            </a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Rejected" asp-route-search="@searchText" class="btn btn-sm @(currentStatus == OrderStatus.Rejected ? "btn-danger" : "btn-outline-danger")">
                <i class="bi bi-x-circle me-1"></i>Reddedilenler
            </a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Shipped" asp-route-search="@searchText" class="btn btn-sm @(currentStatus == OrderStatus.Shipped ? "btn-info" : "btn-outline-info text-dark")">
                <i class="bi bi-truck me-1"></i>Kargodakiler
            </a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Completed" asp-route-search="@searchText" class="btn btn-sm @(currentStatus == OrderStatus.Completed ? "btn-primary" : "btn-outline-primary")">
                <i class="bi bi-check-all me-1"></i>Tamamlananlar
            </a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Sipariş Numarası</th>
                    <th>Müşteri</th>
                    <th>E-posta</th>
                    <th>Tarih</th>
                    <th class="text-center">Kalem</th>
                    <th class="text-end">Toplam Tutar</th>
                    <th class="text-center">Sipariş Durumu</th>
                    <th class="text-center" style="width: 110px;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Seçili kritere uygun sipariş bulunamadı.</td>
                    </tr>
                }
                @foreach (var order in Model.Items)
                {
                    <tr>
                        <td class="fw-bold font-monospace">@order.OrderNumber</td>
                        <td class="fw-semibold">@order.CustomerName</td>
                        <td class="small text-muted">@order.CustomerEmail</td>
                        <td class="small">@order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-center">@order.ItemCount</td>
                        <td class="text-end fw-bold text-dark">@order.TotalAmount.ToString("N2") ₺</td>
                        <td class="text-center">
                            @switch (order.OrderStatus)
                            {
                                case OrderStatus.Pending:
                                    <span class="badge badge-status-pending border px-3 py-1">
                                        <i class="bi bi-clock me-1"></i>Onay Bekliyor
                                    </span>
                                    break;
                                case OrderStatus.Approved:
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Onaylandı
                                    </span>
                                    break;
                                case OrderStatus.Rejected:
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                                        <i class="bi bi-x-circle me-1"></i>Reddedildi
                                    </span>
                                    break;
                                case OrderStatus.Shipped:
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-1">
                                        <i class="bi bi-truck me-1"></i>Kargoda
                                    </span>
                                    break;
                                case OrderStatus.Completed:
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1">
                                        <i class="bi bi-check-all me-1"></i>Tamamlandı
                                    </span>
                                    break;
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Detail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary" title="Sipariş Detayı ve Durum Yönetimi">
                                <i class="bi bi-eye me-1"></i>İncele
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1 || Model.TotalCount > 0)
    {
        <div class="card-footer bg-white py-3 border-top d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div class="text-muted small">
                Toplam <strong>@Model.TotalCount</strong> sipariş | Sayfa <strong>@Model.PageNumber</strong> / <strong>@Math.Max(1, Model.TotalPages)</strong>
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Sipariş Sayfalama">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.PageNumber - 1)"
                               asp-route-status="@currentStatus"
                               asp-route-search="@searchText">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-status="@currentStatus"
                                   asp-route-search="@searchText">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.PageNumber + 1)"
                               asp-route-status="@currentStatus"
                               asp-route-search="@searchText">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>
